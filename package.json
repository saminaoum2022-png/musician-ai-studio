{
  "name": "musician-ai-studio",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node -e \"try{require('fs').existsSync('node_modules/ffmpeg-static/install.js')&&require('child_process').execSync('node node_modules/ffmpeg-static/install.js',{stdio:'inherit'})}catch(e){console.error('ffmpeg-static postinstall skipped:',e.message)}\"",
    "sync:client-env": "node scripts/sync-client-env.mjs",
    "env:staging": "node scripts/use-api-env.mjs staging",
    "env:production": "node scripts/use-api-env.mjs production",
    "sim": "NABAD_API_ENV=staging sh ios/App/scripts/run-ios-sim.sh",
    "run:ios:staging": "NABAD_API_ENV=staging sh ios/App/scripts/run-ios-device.sh",
    "run:ios:production": "NABAD_API_ENV=production sh ios/App/scripts/run-ios-device.sh",
    "stamp:build": "node scripts/stamp-build.mjs && node scripts/sync-www.mjs",
    "sync:www": "node scripts/sync-www.mjs",
    "build:seo": "node scripts/build-seo-assets.mjs && node scripts/build-seo-hero-screenshots.mjs && node scripts/build-seo-pages.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:seo:local": "node scripts/check-seo.mjs --local",
    "build:app-store": "node scripts/build-app-store-metadata.mjs && node scripts/build-app-store-screenshots.mjs",
    "build:icons": "node scripts/build-app-icon.mjs",
    "sync:ios": "node scripts/sync-www.mjs && npx cap sync ios && node scripts/patch-ios-capacitor-plugins.mjs",
    "fix:xcode": "sh ios/App/scripts/fix-xcode-ios.sh",
    "run:ios": "sh ios/App/scripts/run-ios-device.sh",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@onesignal/capacitor-plugin": "^1.1.3",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@vercel/functions": "^2.2.13",
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  }
}
