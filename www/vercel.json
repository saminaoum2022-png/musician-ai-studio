{
  "buildCommand": "node scripts/vercel-prepare-web.mjs && node scripts/sync-client-env.mjs && node scripts/bundle-supabase.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nabadai.com" }],
      "destination": "https://www.nabadai.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/suno/stems.js": {
      "includeFiles": "node_modules/ffmpeg-static/**",
      "maxDuration": 300
    },
    "api/suno/upload-audio.js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/render-video.js": {
      "includeFiles": "node_modules/ffmpeg-static/**",
      "maxDuration": 60
    },
    "api/songs/archive.js": {
      "maxDuration": 60
    },
    "api/music/cover-art.js": {
      "maxDuration": 60
    },
    "api/music/generate.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/social?type=chart_notify_cron", "schedule": "0 17 * * *" },
    { "path": "/api/cron/suno-watch-sweep", "schedule": "*/2 * * * *" }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/s/:id", "destination": "/api/share?id=:id" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/", "destination": "/index.html" },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.nabadai.com" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.nabadai.com" }],
      "destination": "/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/icons/splash-logo.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/marketing.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/assets/marketing/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
